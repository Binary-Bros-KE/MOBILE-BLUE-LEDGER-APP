# Copy to .env.local and adjust. NEXT_PUBLIC_ vars are readable by the browser — never put a
# secret in one. This app has no secrets of its own (the mobile session JWT is issued by SERVER,
# not stored here).

# The Blue Ledger API (SERVER folder). Change this when the API moves — nothing else in this app
# should ever hardcode a URL.
NEXT_PUBLIC_API_URL=http://localhost:4000
